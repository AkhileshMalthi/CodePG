# Copy this file to .env and fill in your API keys

# Groq API key for AI code generation
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# AI Model Settings
# CODEPG_AI_MODEL_TYPE=groq
# CODEPG_AI_MODEL_NAME=mixtral-8x7b-32768

# Uncomment to use Ollama instead of Groq
# CODEPG_AI_MODEL_TYPE=ollama
# CODEPG_AI_MODEL_NAME=llama2
